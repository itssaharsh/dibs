# Copy to .env (never commit .env). Test-only keys funded with test MON only.

# Monad testnet RPCs. HTTP is comma-separated; the server rotates across them.
MONAD_RPC_HTTP=https://testnet-rpc.monad.xyz,https://rpc.ankr.com/monad_testnet,https://rpc-testnet.monadinfra.com
MONAD_RPC_WS=wss://testnet-rpc.monad.xyz

# Operator: funds burners, runs the keeper and the bot round. Keep > 10 MON (Monad reserve) plus what it hands out.
OPERATOR_PK=
# Deploys the contracts; use the same key as OPERATOR_PK.
DEPLOYER_PK=

# Protects Start drop and Run bot round (openssl rand -hex 16).
PRESENTER_KEY=

NEXT_PUBLIC_CHAIN_ID=10143
# Filled after the contracts deploy (T03).
NEXT_PUBLIC_DROPHOUSE=0xb6517ec3d3b676f0ed2e278ef9955fba98352a75
NEXT_PUBLIC_TOKEN=0x9266e65380e7f1bd5fc64a9a4f4fb9f1a6acf27c
NEXT_PUBLIC_FUNDER=0x3f3f1e5fb18c95736f089776352d15e9bc4149f4
DEPLOY_BLOCK=69796067
